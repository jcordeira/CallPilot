# Follow Up Boss
FOLLOW_UP_BOSS_API_KEY=
FOLLOW_UP_BOSS_USER_ID=
FOLLOW_UP_BOSS_ASSIGNED_TO=
FOLLOW_UP_BOSS_SYSTEM=LoanPilot
FOLLOW_UP_BOSS_SYSTEM_KEY=

# Who receives scored tasks inside Follow Up Boss
# Hot (90+) Call today → loan officer. Warm/Cool → loan officer assistant.
FUB_LO_NAME=Joseph Cordeira
FUB_LOA_NAME=Frank Cordeira
FUB_LO_USER_ID=1
FUB_LOA_USER_ID=16
# Miss reminders. Off until LOA_REMINDERS_ENABLED=true.
# LOA_REMINDERS_DRY_RUN=true logs the digest and does not post notes or send SMS.
# Phones below are recipient cells (placeholders for this team). They are not code defaults.
LOA_REMINDERS_ENABLED=false
LOA_REMINDERS_DRY_RUN=false
LOA_REMINDER_LOOKBACK_HOURS=24
LOA_REMINDER_TEXT_WINDOW_MINUTES=120
LOA_REMINDER_CALL_GRACE_MINUTES=15
LOA_REMINDER_TIMEZONE=America/New_York
LOA_REMINDER_MAX_NOTES=15
LOA_REMINDER_MAX_PEOPLE=8
FUB_LO_PHONE=+15169969070
FUB_LOA_USER_IDS=16,27
FUB_LOA_NAME_16=Frankie Cordeira
FUB_LOA_PHONE_16=+16315126480
FUB_LOA_NAME_27=Daniel Ebbecke
FUB_LOA_PHONE_27=+15165213121
# Optional webhook verification. Off unless FUB_WEBHOOK_VERIFY=true
# or FUB_WEBHOOK_SECRET is non-empty. When on, POST /api/webhooks/fub
# requires FUB-Signature = HMAC-SHA256 (hex) of the base64 raw body,
# keyed with FOLLOW_UP_BOSS_SYSTEM_KEY (not the secret string itself).
FUB_WEBHOOK_VERIFY=
FUB_WEBHOOK_SECRET=

# Gmail (OAuth access token for the loan officer inbox)
GMAIL_ACCESS_TOKEN=

# Google Calendar + Tasks — preferred: OAuth connect from the Hub
# Create an OAuth client (Web) in Google Cloud Console with redirect:
#   https://YOUR_SITE/.netlify/functions/...  OR  https://YOUR_SITE/api/google/callback
# Enable Google Calendar API + Google Tasks API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKS_LIST_ID=@default

# Optional fallback (static token — expires; prefer Hub "Connect Google Calendar")
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_TASKS_ACCESS_TOKEN=

# Public REST API (/api/v1). Demo mode also accepts the key "demo-key".
LOANPILOT_API_KEY=

# Quo / OpenPhone — iPhone business SMS.
# QUO_FROM_NUMBER is Joseph's Quo inbox (the From line), in E.164. It is not his cell.
# Find it in Quo → Settings → Phone numbers, or:
#   curl -s -H "Authorization: $QUO_API_KEY" https://api.openphone.com/v1/phone-numbers
# Use the `number` field (the OpenPhone-compatible API is what LoanPilot calls).
# Optional override: QUO_API_BASE=https://api.openphone.com/v1
QUO_API_KEY=
QUO_FROM_NUMBER=
QUO_WEBHOOK_SECRET=

# Neo Mail (optional — prefer forwarding Neo → Gmail).
# NEO_ENABLED=false skips Neo. Live mode returns nothing until IMAP is set;
# it does not invent sample messages.
NEO_ENABLED=true
NEO_IMAP_HOST=
NEO_IMAP_USER=
NEO_IMAP_PASSWORD=

# Assistant
ASSISTANT_DEMO_MODE=true
# Default reply engine is Grok (xAI) via Netlify AI Gateway → OpenRouter.
# After first production deploy these are auto-injected — do not set your own keys.
# OPENROUTER_BASE_URL=
# OPENROUTER_API_KEY=
ASSISTANT_MODEL=x-ai/grok-4.5
# Or switch to OpenAI: ASSISTANT_MODEL=gpt-4o-mini (and set aiProvider=openai in the UI)
