# Follow Up Boss
FOLLOW_UP_BOSS_API_KEY=
FOLLOW_UP_BOSS_USER_ID=
FOLLOW_UP_BOSS_ASSIGNED_TO=
FOLLOW_UP_BOSS_SYSTEM=LoanPilot
FOLLOW_UP_BOSS_SYSTEM_KEY=

# Who receives scored tasks inside Follow Up Boss
# Hot (90+) Call today → loan officer. Warm/Cool → loan officer assistant.
# Set to false to keep Hub scores but stop Follow Up Boss heat notes and tasks.
LEAD_HEAT_WRITES_ENABLED=true
FUB_LO_NAME=Joseph Cordeira
FUB_LOA_NAME=Frank Cordeira
FUB_LO_USER_ID=1
FUB_LOA_USER_ID=16
# Miss reminders. Off until LOA_REMINDERS_ENABLED=true.
# LOA_REMINDERS_DRY_RUN=true logs the digest and does not post notes or send SMS.
# Phones below are recipient cells (placeholders for this team). They are not code defaults.
LOA_REMINDERS_ENABLED=false
LOA_REMINDERS_DRY_RUN=false
LOA_REMINDER_LOOKBACK_HOURS=24
LOA_REMINDER_TEXT_WINDOW_MINUTES=120
LOA_REMINDER_CALL_GRACE_MINUTES=15
LOA_REMINDER_TIMEZONE=America/New_York
LOA_REMINDER_MAX_NOTES=15
LOA_REMINDER_MAX_PEOPLE=8
FUB_LO_PHONE=+15169969070
FUB_LOA_USER_IDS=16,27,32
FUB_LOA_NAME_16=Frankie Cordeira
FUB_LOA_PHONE_16=+16315126480
# Optional extra cells for command mode when TEAM_MEMBERS is unset. Comma-separated. Reminders still use FUB_LOA_PHONE_<id>.
# FUB_LOA_ALT_PHONES_16=+16315460457
FUB_LOA_NAME_27=Daniel Ebbecke
FUB_LOA_PHONE_27=+15165213121
# FUB_LOA_ALT_PHONES_27=+15169087631
FUB_LOA_NAME_32=Debra Rose
FUB_LOA_PHONE_32=+12013946798
# Optional webhook verification. Off unless FUB_WEBHOOK_VERIFY=true
# or FUB_WEBHOOK_SECRET is non-empty. When on, POST /api/webhooks/fub
# requires FUB-Signature = HMAC-SHA256 (hex) of the base64 raw body,
# keyed with FOLLOW_UP_BOSS_SYSTEM_KEY (not the secret string itself).
FUB_WEBHOOK_VERIFY=
FUB_WEBHOOK_SECRET=

# Gmail (OAuth access token for the loan officer inbox)
GMAIL_ACCESS_TOKEN=

# Google Calendar + Tasks — preferred: OAuth connect from the Hub
# Create an OAuth client (Web) in Google Cloud Console with redirect:
#   https://YOUR_SITE/.netlify/functions/...  OR  https://YOUR_SITE/api/google/callback
# Enable Google Calendar API + Google Tasks API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
# Hub sign-in. Required before /hub, /calendar, /assistant, and /api (except webhooks, cron, and the Google OAuth callback).
# The session cookie is HMAC-signed. HUB_SESSION_SECRET defaults to HUB_PASSWORD.
HUB_PASSWORD=
HUB_SESSION_SECRET=
HUB_SESSION_DAYS=7
GOOGLE_TASKS_LIST_ID=@default

# Optional fallback (static token — expires; prefer Hub "Connect Google Calendar")
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_TASKS_ACCESS_TOKEN=

# Add Frankie to Joseph's client appointments. Off until CALENDAR_AUTO_GUEST_ENABLED=true.
# Default guest is Frankie Cordeira (FUB user 16). Comma-separate more addresses if needed.
# NOTIFY=ics patches with sendUpdates=none, then emails Frankie an .ics from the connected
# Google account (gmail.send). GMAIL_ACCESS_TOKEN is an optional override. Clients are not emailed.
# NOTIFY=all lets Google email every guest (clients may get an updated invitation).
CALENDAR_AUTO_GUEST_ENABLED=false
CALENDAR_AUTO_GUEST_DRY_RUN=false
CALENDAR_AUTO_GUEST_EMAILS=fcordeirajr@cliffcomortgage.com
CALENDAR_AUTO_GUEST_DAYS=60
CALENDAR_AUTO_GUEST_NOTIFY=ics
# CALENDAR_AUTO_GUEST_INCLUDE=call,appt,appointment,consult,refi,purchase,preapproval,pre-approval,heloc
# CALENDAR_AUTO_GUEST_EXCLUDE=birthday,galligan group,team cordeira weekly,week setup,joe cordeira + alicia,heloc steps,eric / joe

# Public REST API (/api/v1). Demo mode also accepts the key "demo-key".
LOANPILOT_API_KEY=

# Quo / OpenPhone — iPhone business SMS.
# QUO_FROM_NUMBER is the Sales line LoanPilot texts from and listens on, in E.164.
# This team's Sales line is +15163869773. It is not Joseph's cell.
# Find it in Quo → Settings → Phone numbers, or:
#   curl -s -H "Authorization: $QUO_API_KEY" https://api.openphone.com/v1/phone-numbers
# Use the `number` field (the OpenPhone-compatible API is what LoanPilot calls).
# Optional override: QUO_API_BASE=https://api.openphone.com/v1
# QUO_WEBHOOK_SECRET is the signing key from the webhook (whsec_... or the revealed base64 secret).
QUO_API_KEY=
QUO_FROM_NUMBER=+15163869773
QUO_WEBHOOK_SECRET=
# SMS segment caps. Quo bills $0.01 per segment (160 GSM-7 chars, 70 when a character is outside GSM-7).
# Extension characters []{}|^~\€ count as two. Line breaks count. Long links count.
# SMS_MAX_SEGMENTS_PER_MESSAGE default 2. Longer texts are shortened, except a `text <client>:` command.
# SMS_DAILY_SEGMENT_CAP default 60 segments per Eastern Time day across everyone.
# Normal alerts stop at 80% of that cap. Missed-call, contract, and command replies can use the rest.
# SMS_PER_RECIPIENT_DAILY_CAP default 20. A blocked text is skipped; the Follow Up Boss note still posts.
# The first time the daily cap is hit, Joseph (+15169969070) gets one notice.
# SMS_LINK_BASE is an optional shorter host for /p/<id> links, with or without https://.
# SMS_MAX_SEGMENTS_PER_MESSAGE=2
# SMS_DAILY_SEGMENT_CAP=60
# SMS_PER_RECIPIENT_DAILY_CAP=20
# SMS_LINK_BASE=

# Cordeira team line (+15163094960) is a Follow Up Boss dialer/texting number, not Quo.
# Off until CORDEIRA_LINE_ALERTS_ENABLED=true. Existing FUB webhooks are enough:
# callsCreated, callsUpdated, and textMessagesCreated on /api/webhooks/fub.
# Do not add this number to the Quo webhook.
# A missed call on this line alerts immediately. An inbound text alerts when no team
# outbound text or answered call happens for 10 minutes.
# Alert SMS goes out from QUO_FROM_NUMBER (the Sales line).
# Monday–Friday texts CORDEIRA_WEEKDAY_PHONES (default Frankie, FUB_LOA_PHONE_<id> or +16315126480).
# Saturday and Sunday texts CORDEIRA_WEEKEND_PHONES (default Joseph, FUB_LO_PHONE or +15169969070).
# The day is America/New_York at send time. The Follow Up Boss note still @mentions both.
# CORDEIRA_WEEKDAY_PHONES=+16315126480
# CORDEIRA_WEEKEND_PHONES=+15169969070
# CORDEIRA_LINE_PHONE_ID is optional. Set it to the FUB sharedInboxId or dialer line id
# only when records omit fromNumber and toNumber. Leave it unset when those numbers are present.
CORDEIRA_LINE_ALERTS_ENABLED=false
CORDEIRA_LINE_NUMBER=+15163094960
CORDEIRA_LINE_TEXT_WAIT_MINUTES=10
# CORDEIRA_LINE_PHONE_ID=
# CORDEIRA_LINE_ALERTS_DRY_RUN=false

# FUB call summaries. Off until CALL_SUMMARIES_ENABLED=true.
# callsCreated and callsUpdated are already subscribed on /api/webhooks/fub.
# A transcript that arrives later is also picked up by the 15-minute loa-reminders sweep
# (calls created in the last 24 hours). This posts one FUB note per call id. It does not text or email.
# The note is written by the Netlify AI Gateway (OPENAI_BASE_URL + OPENAI_API_KEY, or
# NETLIFY_AI_GATEWAY_BASE_URL + NETLIFY_AI_GATEWAY_KEY). Leave those unset so Netlify can inject them.
# The model is gpt-4o-mini unless COMMAND_MODEL is set. If the gateway is missing, the call is skipped.
CALL_SUMMARIES_ENABLED=false

# Buyer Contract alerts. On unless CONTRACT_ALERTS_ENABLED=false (unset is on).
# Texts Debra when a Purchase deal (pipeline id 1) is created in, or moves into,
# Buyer Contract (stage id 14). Register FUB webhooks dealsCreated and dealsUpdated
# on the existing /api/webhooks/fub URL. The 15-minute loa-reminders sweep also
# catches an entry from the last 24 hours. SMS is from QUO_FROM_NUMBER.
# One text and one @mention note per deal entry. A later re-entry can alert again.
CONTRACT_ALERTS_ENABLED=true
CONTRACT_ALERT_PHONES=+12013946798
# CONTRACT_ALERT_USER_ID=32
# CONTRACT_ALERT_NAME=Debra Rose
# Also texts the lead (the deal's primary person) from QUO_FROM_NUMBER with the
# approved contract-received message. On unless CONTRACT_CLIENT_TEXT_ENABLED=false.
# One client text per deal entry. A daily-budget skip or a Quo 402 retries on the
# next sweep while that entry is still inside 24 hours. Client replies to the Sales
# line are ignored. The message is exempt from truncation and counts as high priority.
CONTRACT_CLIENT_TEXT_ENABLED=true

# Command mode. Off until COMMAND_MODE_ENABLED=true.
# Dry run (default) parses the text and replies to the sender with a [preview]. It does not book, text clients, or text the team.
# COMMAND_PREFIX is optional. Leave it empty: only the owner cell and TEAM_MEMBERS are accepted.
# TEAM_MEMBERS replaces the LOA-phone fallback for command mode. userId is the Follow Up Boss user. A lead assignment @mentions that user and texts their primary phone.
# altPhones are extra cells that may text in. Replies go back to the number that texted. Team texts and reminders still use phone.
# Alternative: TEAM_MEMBER_1_NAME, TEAM_MEMBER_1_PHONE, TEAM_MEMBER_1_ALT_PHONES, TEAM_MEMBER_1_EMAIL, TEAM_MEMBER_1_USER_ID, TEAM_MEMBER_1_TITLE (through _20_). ALT_PHONES is comma-separated.
TEAM_MEMBERS='[{"name":"Frankie Cordeira","phone":"+16315126480","altPhones":["+16315460457"],"email":"fcordeirajr@cliffcomortgage.com","userId":16,"title":"LOA"},{"name":"Daniel Ebbecke","phone":"+15165213121","altPhones":["+15169087631"],"email":"debbecke@cliffcomortgage.com","userId":27,"title":"LOA"},{"name":"Debra Rose","phone":"+12013946798","email":"drose@cliffcomortgage.com","userId":32,"title":"Processor"}]'
# AI: Netlify AI Gateway injects OPENAI_BASE_URL and OPENAI_API_KEY (or NETLIFY_AI_GATEWAY_*).
# Leave those unset. The command model is gpt-4o-mini unless COMMAND_MODEL is set.
# OPENROUTER_* is optional and only used when you set it yourself.
COMMAND_MODE_ENABLED=false
COMMAND_MODE_DRY_RUN=true
# COMMAND_PREFIX=
# COMMAND_TIMEZONE=America/New_York
# COMMAND_HOURS_START=9
# COMMAND_HOURS_END=18
# COMMAND_WORK_DAYS=1,2,3,4,5
# COMMAND_CONFIRM_MINUTES=15
# COMMAND_MODEL=

# WhatsApp auto-reply (Kapso + Meta coexistence). Off until WHATSAPP_AUTOREPLY_ENABLED=true.
# Connect Joseph's WhatsApp Business app number (+15169969070) in Kapso coexistence mode.
# KAPSO_PHONE_NUMBER_ID is that number's Meta phone number id, not the E.164 line.
# Create the API key in Kapso → Integrations → API keys. Webhook secret is the secret_key
# on the phone-number webhook (Kapso → the number → webhooks).
# Point the webhook at https://<site>/api/webhooks/whatsapp
# Subscribe: whatsapp.message.received, whatsapp.message.sent
# Optional: whatsapp.conversation.inactive (the every-minute function is the timer).
WHATSAPP_AUTOREPLY_ENABLED=false
WHATSAPP_AUTOREPLY_DRY_RUN=false
WHATSAPP_AUTOREPLY_WAIT_MINUTES=5
WHATSAPP_AUTOREPLY_COOLDOWN_HOURS=4
WHATSAPP_AUTOREPLY_MAX_AGE_HOURS=24
# WHATSAPP_AUTOREPLY_TEXT=Thanks for your message! I'm on another call or in a meeting right now and will get back to you as soon as possible. - Joseph
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# KAPSO_API_BASE=https://api.kapso.ai/meta/whatsapp/v24.0

# Neo Mail (optional — prefer forwarding Neo → Gmail).
# NEO_ENABLED=false skips Neo. Live mode returns nothing until IMAP is set;
# it does not invent sample messages.
NEO_ENABLED=true
NEO_IMAP_HOST=
NEO_IMAP_USER=
NEO_IMAP_PASSWORD=

# Assistant
ASSISTANT_DEMO_MODE=true
# Default reply engine is Grok (xAI) via Netlify AI Gateway → OpenRouter.
# After first production deploy these are auto-injected — do not set your own keys.
# OPENROUTER_BASE_URL=
# OPENROUTER_API_KEY=
ASSISTANT_MODEL=x-ai/grok-4.5
# Or switch to OpenAI: ASSISTANT_MODEL=gpt-4o-mini (and set aiProvider=openai in the UI)
